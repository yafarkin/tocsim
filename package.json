{
  "name": "toc-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
